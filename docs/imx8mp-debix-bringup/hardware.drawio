r=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="10" y="112" width="74" height="62" as="geometry"/></mxCell><mxCell id="i2c" value="I2C1 · I2C2 · I2C3&lt;br&gt;on ×3&lt;br&gt;(PMIC, DDC 等)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="90" y="112" width="74" height="62" as="geometry"/></mxCell><mxCell id="can2" value="FlexCAN2&lt;br&gt;Linux can0&lt;br&gt;(予備)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="170" y="112" width="74" height="62" as="geometry"/></mxCell><mxCell id="ecspi23" value="ECSPI2 · ECSPI3&lt;br&gt;disabled ×2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="250" y="112" width="74" height="62" as="geometry"/></mxCell><mxCell id="uart3" value="UART3&lt;br&gt;on、未使用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="330" y="112" width="74" height="62" as="geometry"/></mxCell><mxCell id="usdhc1" value="uSDHC1&lt;br&gt;WiFi SDIO&lt;br&gt;disabled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="410" y="112" width="74" height="62" as="geometry"/></mxCell><mxCell id="sdma1" value="SDMA1&lt;br&gt;UART/SPI の&lt;br&gt;DMA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="10" y="192" width="74" height="62" as="geometry"/></mxCell><mxCell id="i2c456" value="I2C4 · I2C5 · I2C6&lt;br&gt;disabled ×3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="90" y="192" width="74" height="62" as="geometry"/></mxCell><mxCell id="spba" value="SPBA 共有バス&lt;br&gt;(ECSPI/UART/&lt;br&gt;FlexCAN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="aips3"><mxGeometry x="170" y="192" width="74" height="62" as="geometry"/></mxCell><mxCell id="flexspi" value="FlexSPI&lt;br&gt;disabled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="250" y="192" width="74" height="62" as="geometry"/></mxCell><mxCell id="uart1" value="UART1&lt;br&gt;on: BT (88W8987)&lt;br&gt;未使用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="330" y="192" width="74" height="62" as="geometry"/></mxCell><mxCell id="usdhc2" value="uSDHC2&lt;br&gt;microSD&lt;br&gt;disabled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="410" y="192" width="74" height="62" as="geometry"/></mxCell><mxCell id="caam3" value="CAAM crypto&lt;br&gt;on: hwrng&lt;br&gt;(rng-caam)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="10" y="272" width="74" height="62" as="geometry"/></mxCell><mxCell id="uart2" value="UART2&lt;br&gt;Linux console&lt;br&gt;ttymxc1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="330" y="272" width="74" height="62" as="geometry"/></mxCell><mxCell id="c37" value="低速ペリフェラル (SPBA を含む): ECSPI @0x3082_0000〜 · UART @0x3086_0000〜 · FlexCAN @0x308C/D_0000 · CAAM @0x3090_0000 · I2C @0x30A2_0000〜 · MU @0x30AA_0000 · uSDHC @0x30B4/5/6_0000 · FlexSPI @0x30BB_0000 · SDMA1 @0x30BD_0000 · FEC/EQOS @0x30BE/F_0000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="aips3"><mxGeometry x="10" y="356" width="480" height="34" as="geometry"/></mxCell><mxCell id="c38" value="AIPS4 @0x32C0_0000 = MEDIAMIX / HSIOMIX / HDMIMIX の制御レジスタ側 (blk-ctrl、LCDIF、DSI、PHY)。AIPS5 @0x30C0_0000 = AUDIOMIX。物理配置は左列の各 MIX として描いている (DT では HDMI 系が bus@30c00000 配下に置かれている)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="soc"><mxGeometry x="700" y="895" width="500" height="56" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;色&lt;/b&gt;: 青 = Linux が使用 / 橙 = M7 (Zephyr) 所有 / 紫 = システム制御 / 黄 = メモリ / 灰点線 = DT で disabled・非搭載 / 緑点線 = 将来案。「×n」「A · B」= 同じ状態の複数インスタンスを 1 箱にまとめた省略 (個別に DT ノードあり)&lt;br&gt;&lt;b&gt;起動&lt;/b&gt;: Boot ROM → SPL (OCRAM、DDR 初期化 ≈0.5〜0.6 s、HDMIMIX を起こしてスプラッシュ +0.7 s、デッドマン env) → BL31 (OCRAM、SIP で M7 を TCM から起動) → falcon-a.itb (Image @0x4040_0000 / DTB @0x4310_0000 / m7 fw) → Linux は remoteproc attach、MU 経由 rpmsg で rpmsgcan0。電源→GUI 3.2 s&lt;br&gt;&lt;b&gt;フォールバック&lt;/b&gt;: boot_os=no → U-Boot proper → extlinux。eMMC 復旧は DIP 011 の SD U-Boot から tftp + mmc write&lt;br&gt;&lt;b&gt;根拠&lt;/b&gt;: 製品 DTB (imx8mp-debix-m7.dtb) の /soc 配下ノードと GPC 電源ドメイン、i.MX8MP RM、DEBIX マニュアル v1.11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fillColor=#fffde7;strokeColor=#d6b656;spacingLeft=6;spacingTop=4;" vertex="1" parent="soc"><mxGeometry x="700" y="965" width="500" height="150" as="geometry"/></mxCell><mxCell id="ddr" value="&lt;b&gt;LPDDR4 4 GB (DEBIX D4E32)&lt;/b&gt; — 3 GB @0x4000_0000〜0xFFFF_FFFF + 1 GB @0x1_0000_0000〜&lt;br&gt;&lt;br&gt;0x4020_0000  BL33 シム (falcon: ATF が跳ぶ先)&lt;br&gt;0x4040_0000  kernel Image (≈35 MB)&lt;br&gt;0x4300_0000  SPL args / 0x4310_0000 DTB&lt;br&gt;0x4800_0000  FIT メタデータ退避 / 0x4A00_0000 SPL ヒープ&lt;br&gt;0x5500_0000  vdev0vring0 / 0x5500_8000 vdev0vring1 (32 KB ずつ、no-map)&lt;br&gt;0x550F_F000  rsc_table 4 KB / 0x5540_0000 vdevbuffer 1 MB (shared-dma-pool)&lt;br&gt;0xBFE0_0000  SPL スプラッシュ FB 2 MB (reserved no-map)&lt;br&gt;0x1_0000_0000〜 +256 MB gpu_reserved (EVK 遺産)&lt;br&gt;&lt;br&gt;/proc/iomem: 0x4000_0000〜0xFFFF_FFFF + 0x1_1000_0000〜0x1_3FFF_FFFF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1610" y="40" width="400" height="310" as="geometry"/></mxCell><mxCell id="j2" value="J2 40pin ヘッダ (M7 の縄張り)&lt;br&gt;CAN1: Pin31/33 (SAI5_RXD1/2) · ECSPI1: Pin20 SCLK / 16 MOSI / 18 MISO / 14 CS (GPIO5_IO09) · UART4: Pin17/19" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1610" y="370" width="400" height="60" as="geometry"/></mxCell><mxCell id="ads" value="ADS8688 モジュール&lt;br&gt;8ch 16-bit SAR ADC&lt;br&gt;(現状 raw SPI、adc_ads868x 化は未)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1610" y="440" width="190" height="56" as="geometry"/></mxCell><mxCell id="canbus" value="CA-IS3050G →&lt;br&gt;CAN バス 1 Mbps&lt;br&gt;(ECU / CANable mock)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1820" y="440" width="190" height="56" as="geometry"/></mxCell><mxCell id="emmc" value="&lt;b&gt;eMMC (uSDHC3、8-bit、boot0/boot1 未使用)&lt;/b&gt; — user 領域、msdos&lt;br&gt;&lt;br&gt;+32 KB  imx-boot A (SPL + DDR fw + BL31 + u-boot.itb) ← ROM&lt;br&gt;+4 MB   imx-boot B (予備)&lt;br&gt;+7 MB   U-Boot env 8 KB、冗長 @0x70_4000 (デッドマン boot_os)&lt;br&gt;p1 BOOTA 256 MB FAT: falcon-a.itb / u-boot.itb / m7-fw.img / logo.bin&lt;br&gt;p2 BOOTB 256 MB FAT · p3 RSV 4 MB&lt;br&gt;p5 roota 1536 MB ext4 (read-only) · p6 rootb&lt;br&gt;p7 data 128 MB ext4 (/data: kmm.env, ログ, /data/fw)&lt;br&gt;&lt;br&gt;OTA: 非アクティブ slot へ書込 → one-shot 試起動 → ab-commit" style="rounded=0;whiteSpace=wrap;html=1;fill