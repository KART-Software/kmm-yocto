<mxfile host="app.diagrams.net" modified="2026-10-02T00:00:00.000Z" agent="claude" version="24.0.0"><diagram id="debix-hw" name="DEBIX Infinity ハード構成"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="1230" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="soc" value="NXP i.MX 8M Plus Quad Lite (MIMX8ML4CVNKZAB) — DEBIX Infinity。箱 = DT ノード / RM のサブシステム、[n] = GPC 電源ドメイン番号" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fontSize=15;fontStyle=1;fillColor=#f7f7f7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="260" y="40" width="1320" height="1130" as="geometry"/></mxCell><mxCell id="c3" value="Cortex-A53 クラスタ ×4 @1.6 GHz&lt;br&gt;EL3 BL31 (OCRAM 常駐) / EL1 Linux 6.6 + kmm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="soc"><mxGeometry x="20" y="50" width="330" height="170" as="geometry"/></mxCell><mxCell id="c4" value="A53 #0&lt;br&gt;32K I$ / 32K D$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="12" y="46" width="72" height="40" as="geometry"/></mxCell><mxCell id="c5" value="A53 #1&lt;br&gt;32K I$ / 32K D$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="92" y="46" width="72" height="40" as="geometry"/></mxCell><mxCell id="c6" value="A53 #2&lt;br&gt;32K I$ / 32K D$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="172" y="46" width="72" height="40" as="geometry"/></mxCell><mxCell id="c7" value="A53 #3&lt;br&gt;32K I$ / 32K D$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="252" y="46" width="72" height="40" as="geometry"/></mxCell><mxCell id="c8" value="L2 512 KB (共有) · NEON/FPU · CoreSight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="12" y="94" width="306" height="30" as="geometry"/></mxCell><mxCell id="c9" value="GIC-500 (GICv3) @0x3880_0000、クラスタ外の独立ブロック · Generic Timer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="12" y="130" width="306" height="30" as="geometry"/></mxCell><mxCell id="m7" value="Cortex-M7 サブシステム @800 MHz&lt;br&gt;Zephyr can-gw、RDC domain 1 (DT: imx8mp-cm7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="soc"><mxGeometry x="370" y="50" width="280" height="170" as="geometry"/></mxCell><mxCell id="c10" value="ITCM 128 KB&lt;br&gt;M7 0x0000_0000&lt;br&gt;A53 0x007E_0000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="m7"><mxGeometry x="12" y="46" width="125" height="56" as="geometry"/></mxCell><mxCell id="c11" value="DTCM 128 KB&lt;br&gt;M7 0x2000_0000&lt;br&gt;A53 0x0080_0000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="m7"><mxGeometry x="143" y="46" width="125" height="56" as="geometry"/></mxCell><mxCell id="c12" value="32K I$ / 32K D$ (RM 2.1.1) · FPU · MPU · NVIC&lt;br&gt;起動: BL31 SIP → SRC が M7 リセット解除。Linux は remoteproc attach、kick は MU (AIPS3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="m7"><mxGeometry x="12" y="110" width="256" height="50" as="geometry"/></mxCell><mxCell id="rom" value="Boot ROM 256 KB&lt;br&gt;DIP 010=eMMC / 001=USB SDP (UUU) / 011=SD&lt;br&gt;SPL は eMMC user +32 KB から (uSDHC3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="670" y="50" width="170" height="72" as="geometry"/></mxCell><mxCell id="c13" value="APBH-DMA @0x3300_0000&lt;br&gt;GPMI NAND (disabled)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="670" y="130" width="170" height="40" as="geometry"/></mxCell><mxCell id="c14" value="NoC 付属: QoSC (AXI 優先度) · PERFMON · DBGMON&lt;br&gt;HAB (セキュアブート): 未署名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="670" y="178" width="170" height="42" as="geometry"/></mxCell><mxCell id="ocram" value="OCRAM 576 KB @0x0090_0000&lt;br&gt;Linux 448 KB (ocram ノード) · 末尾 128 KB は BL31 用予約 (@0x0097_0000) · SPL 実行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="soc"><mxGeometry x="860" y="50" width="170" height="62" as="geometry"/></mxCell><mxCell id="c15" value="OCRAM_S 36 KB @0x0018_0000&lt;br&gt;CAAM 専用 RAM @0x0010_0000 (caam-sm)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="soc"><mxGeometry x="860" y="120" width="170" height="44" as="geometry"/></mxCell><mxCell id="rdc" value="RDC @0x303D_0000 (DT 外、RM)&lt;br&gt;M7 = domain1、FlexCAN1/ECSPI1 を譲渡" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="860" y="172" width="170" height="48" as="geometry"/></mxCell><mxCell id="ddrc" value="DDRC (snps) @0x3D40_0000&lt;br&gt;+ DDR PHY · DDR PMU @0x3D80_0000&lt;br&gt;&lt;br&gt;LPDDR4 32-bit&lt;br&gt;3732 MT/s&lt;br&gt;(ベンダーは 3264)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="soc"><mxGeometry x="1050" y="50" width="150" height="170" as="geometry"/></mxCell><mxCell id="noc" value="NoC  interconnect@3270_0000  (fsl,imx8mp-noc、busfreq は disabled)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bbbbbb;strokeColor=#555555;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="soc"><mxGeometry x="640" y="250" width="40" height="870" as="geometry"/></mxCell><mxCell id="hsio" value="HSIOMIX [17] — hsio_blk_ctrl @0x32F1_0000 (USB / USB_PHY1 / USB_PHY2 / PCIE / PCIE_PHY)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#fafafa;strokeColor=#777777;" vertex="1" parent="soc"><mxGeometry x="20" y="250" width="600" height="140" as="geometry"/></mxCell><mxCell id="usb0" value="USB3_0 dwc3 @0x32F1_0100 (コア @0x3810_0000)&lt;br&gt;+ PHY @0x381F_0040 [2]&lt;br&gt;USB1: host 固定 (OTG/UUU の口)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="hsio"><mxGeometry x="10" y="32" width="180" height="48" as="geometry"/></mxCell><mxCell id="usb1" value="USB3_1 dwc3 @0x32F1_0108 (コア @0x3820_0000)&lt;br&gt;+ PHY @0x382F_0040 [3]&lt;br&gt;USB2: host、接続先は未確認" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="hsio"><mxGeometry x="10" y="86" width="180" height="48" as="geometry"/></mxCell><mxCell id="pcie" value="PCIe Gen3 ×1 @0x3380_0000&lt;br&gt;+ PHY @0x32F0_0000 [1]&lt;br&gt;disabled (19pin FPC のみ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="hsio"><mxGeometry x="200" y="32" width="180" height="48" as="geometry"/></mxCell><mxCell id="c16" value="GPIO4_IO25/26 (AIPS1) を hog で High = Type-A 給電&lt;br&gt;(ベンダー DTS の hub-pwd / hub-reset、2026-09-21)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="hsio"><mxGeometry x="200" y="86" width="180" height="48" as="geometry"/></mxCell><mxCell id="c17" value="GPC: hsiomix [17] · usb1_phy [2] · usb2_phy [3] · pcie_phy [1]&lt;br&gt;いずれも on。PCIe だけ DT disabled。&lt;br&gt;blk-ctrl が各ブロックの電源ドメインを子として提供" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="hsio"><mxGeometry x="390" y="32" width="200" height="102" as="geometry"/></mxCell><mxCell id="hdmimix" value="HDMIMIX [14] — hdmi_blk_ctrl @0x32FC_0000 (IRQSTEER / LCDIF / PAI / PVI / TRNG / HDMI_TX / HDMI_TX_PHY / HDCP / HRV)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#fafafa;strokeColor=#777777;" vertex="1" parent="soc"><mxGeometry x="20" y="405" width="600" height="140" as="geometry"/></mxCell><mxCell id="hdmitx" value="HDMI TX (DesignWare v2.13a)&lt;br&gt;@0x32FD_8000&lt;br&gt;Samsung HDMI PHY @0x32FD_FF00 [15]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="hdmimix"><mxGeometry x="10" y="32" width="180" height="48" as="geometry"/></mxCell><mxCell id="c18" value="HDMI PVI / PAI @0x32FC_4000&lt;br&gt;irqsteer @0x32FC_2000&lt;br&gt;TRNG / HDCP / HRV (未使用)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="hdmimix"><mxGeometry x="200" y="32" width="180" height="48" as="geometry"/></mxCell><mxCell id="lcdif3" value="LCDIFv3 (lcdif3) @0x32FC_6000&lt;br&gt;CRTC = /dev/dri/card0&lt;br&gt;SPL スプラッシュの FB 走査" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="hdmimix"><mxGeometry x="390" y="32" width="200" height="48" as="geometry"/></mxCell><mxCell id="c19" value="GPC hdmimix [14] / hdmi_phy [15] は seamless takeover のため常時 ON (パッチ 0010〜0013: probe で PHY リセットしない、blk-ctrl を adopt)。PHY PLL がピクセルクロック源なので、落とすと走査ごと死ぬ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="hdmimix"><mxGeometry x="10" y="86" width="580" height="46" as="geometry"/></mxCell><mxCell id="mediamix" value="MEDIAMIX [10] — media_blk_ctrl @0x32EC_0000 (DSI / CSI2 ×2 / LCDIF_1 / ISI / LCDIF_2 / ISP / DWE)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#fafafa;strokeColor=#777777;" vertex="1" parent="soc"><mxGeometry x="20" y="560" width="600" height="160" as="geometry"/></mxCell><mxCell id="dsi" value="LCDIF1 @0x32E8_0000&lt;br&gt;→ MIPI DSI @0x32E6_0000 (mipi_phy1 [0])&lt;br&gt;disabled (J13 未使用)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="mediamix"><mxGeometry x="10" y="32" width="180" height="52" as="geometry"/></mxCell><mxCell id="ldb" value="LCDIF2 @0x32E9_0000&lt;br&gt;→ LDB + LVDS PHY (phy-lvds)&lt;br&gt;disabled → 将来案 (open-issues #15)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=9;" vertex="1" parent="mediamix"><mxGeometry x="200" y="32" width="180" height="52" as="geometry"/></mxCell><mxCell id="c20" value="MIPI CSI2 ×2 (mipi_phy2 [16]) → ISI&lt;br&gt;isi_chain @0x32E0_2000、disabled&lt;br&gt;ISP / DWE [18]: Quad Lite での搭載は未確認" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="mediamix"><mxGeometry x="390" y="32" width="200" height="52" as="geometry"/></mxCell><mxCell id="c21" value="GPC mediamix [10] は on (DT の既定)。ldb/ldb_phy/lcdif1/lcdif2 を DT で disabled、slim カーネルは LDB ドライバも除外 — ldb を有効のままドライバ無しにすると imx-drm の束ねが止まり /dev/dri ごと消える (2026-09-02)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="mediamix"><mxGeometry x="10" y="92" width="580" height="56" as="geometry"/></mxCell><mxCell id="audiomix" value="AUDIOMIX [5] — audio_blk_ctrl @0x30E2_0000 (AIPS5 @0x30C0_0000 の SPBA)、audiomix-pd" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#f0f0f0;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="soc"><mxGeometry x="20" y="735" width="600" height="110" as="geometry"/></mxCell><mxCell id="c22" value="SAI1/2/3/5/6/7 · MICFIL · EASRC · AUD2HTX · XCVR (eARC)&lt;br&gt;全て disabled (音声は製品で未使用)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="audiomix"><mxGeometry x="10" y="32" width="250" height="40" as="geometry"/></mxCell><mxCell id="c23" value="SDMA2/3 @0x30E0_0000/1_0000&lt;br&gt;disabled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="audiomix"><mxGeometry x="270" y="32" width="140" height="40" as="geometry"/></mxCell><mxCell id="c24" value="HiFi4 DSP @0x3B6E_8000 (disabled)&lt;br&gt;OCRAM_A 256 KB · MU2 @0x30E6_0000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="audiomix"><mxGeometry x="420" y="32" width="170" height="40" as="geometry"/></mxCell><mxCell id="c25" value="sound-hdmi / sound-wm8960 / sound-micfil / sound-xcvr / bt-sco: DT で disabled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="audiomix"><mxGeometry x="10" y="76" width="580" height="26" as="geometry"/></mxCell><mxCell id="c26" value="GPUMIX [7]&lt;br&gt;GPU3D GC7000UL @0x3800_0000 [9]&lt;br&gt;GPU2D GC520L @0x3800_8000 [6]&lt;br&gt;搭載だが不使用 (weston は pixman 合成、DRM は lcdif のみ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="20" y="860" width="190" height="120" as="geometry"/></mxCell><mxCell id="c27" value="VPUMIX [8] — vpumix_blk_ctl @0x3833_0000&lt;br&gt;VPU G1 [11] / G2 [12] / VC8000E [13]&lt;br&gt;Quad Lite で非搭載 (fuse-out)。pgc は DT で disabled (「failed to command PGC」対策)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="225" y="860" width="190" height="120" as="geometry"/></mxCell><mxCell id="c28" value="MLMIX [4]&lt;br&gt;NPU (VIP8000 / vipsi @0x3850_0000)&lt;br&gt;Quad Lite で非搭載。pgc_mlmix を DT で disabled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="430" y="860" width="190" height="120" as="geometry"/></mxCell><mxCell id="aips1" value="AIPS1 @0x3000_0000 — システム制御・GPIO (fsl,aips-bus)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#fafafa;strokeColor=#777777;" vertex="1" parent="soc"><mxGeometry x="700" y="250" width="500" height="130" as="geometry"/></mxCell><mxCell id="gpio" value="GPIO1〜5 (×5) @0x3020_0000〜&lt;br&gt;GPIO4_25/26 = USB ハブ給電 hog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="10" y="30" width="115" height="42" as="geometry"/></mxCell><mxCell id="c29" value="IOMUXC (pinctrl) @0x3033_0000&lt;br&gt;IOMUXC_GPR @0x3034_0000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="132" y="30" width="115" height="42" as="geometry"/></mxCell><mxCell id="ccm" value="CCM @0x3038_0000&lt;br&gt;ANATOP @0x3036_0000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="254" y="30" width="115" height="42" as="geometry"/></mxCell><mxCell id="src" value="SRC @0x3039_0000 (M7 起動)&lt;br&gt;GPC @0x303A_0000 ([0..18])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="376" y="30" width="115" height="42" as="geometry"/></mxCell><mxCell id="c30" value="TMU @0x3026_0000&lt;br&gt;GPT1〜3 (×3) @0x302D_0000〜" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8