<mxfile host="app.diagrams.net" modified="2026-10-04T00:00:00.000Z" agent="claude" version="24.0.0"><diagram id="xpi-hw" name="XPI-iMX8MM ハード構成"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="1230" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="soc" value="NXP i.MX 8M Mini Quad (MIMX8MM6、U-Boot 表示 i.MX8MMQ rev1.0) — XPI-iMX8MM。箱 = DT ノード / RM のサブシステム、[n] = GPC 電源ドメイン番号" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fontSize=15;fontStyle=1;fillColor=#f7f7f7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="260" y="40" width="1320" height="1130" as="geometry"/></mxCell><mxCell id="c3" value="Cortex-A53 クラスタ ×4 @1.8 GHz (起動中 1.2 GHz、SPL overdrive パッチ 0012)&lt;br&gt;EL3 BL31 (OCRAM 常駐) / EL1 Linux 6.12 (linux-fslc) + kmm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="soc"><mxGeometry x="20" y="50" width="330" height="170" as="geometry"/></mxCell><mxCell id="c4" value="A53 #0&lt;br&gt;32K I$ / 32K D$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="12" y="46" width="72" height="40" as="geometry"/></mxCell><mxCell id="c5" value="A53 #1&lt;br&gt;32K I$ / 32K D$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="92" y="46" width="72" height="40" as="geometry"/></mxCell><mxCell id="c6" value="A53 #2&lt;br&gt;32K I$ / 32K D$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="172" y="46" width="72" height="40" as="geometry"/></mxCell><mxCell id="c7" value="A53 #3&lt;br&gt;32K I$ / 32K D$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="252" y="46" width="72" height="40" as="geometry"/></mxCell><mxCell id="c8" value="L2 512 KB (共有) · NEON/FPU · CoreSight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="12" y="94" width="306" height="30" as="geometry"/></mxCell><mxCell id="c9" value="GIC-500 (GICv3) @0x3880_0000、クラスタ外の独立ブロック · Generic Timer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="12" y="130" width="306" height="30" as="geometry"/></mxCell><mxCell id="m4" value="Cortex-M4 サブシステム @400 MHz (Zephyr 側で引き上げ)&lt;br&gt;Zephyr can-gw、RDC domain 1 (DT: imx8mm-cm4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="soc"><mxGeometry x="370" y="50" width="280" height="170" as="geometry"/></mxCell><mxCell id="c10" value="TCML 128 KB&lt;br&gt;M4 0x1FFE_0000&lt;br&gt;A53 0x007E_0000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="m4"><mxGeometry x="12" y="46" width="125" height="56" as="geometry"/></mxCell><mxCell id="c11" value="TCMU 128 KB&lt;br&gt;M4 0x2000_0000&lt;br&gt;A53 0x0080_0000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="m4"><mxGeometry x="143" y="46" width="125" height="56" as="geometry"/></mxCell><mxCell id="c12" value="キャッシュ無し (共有メモリ整合は不要、DDR 実行は遅い)&lt;br&gt;起動: BL31 SIP (IMX_SIP_SRC_M4_START) → SRC_M4RCR 解除。Linux は remoteproc attach、kick は MU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="m4"><mxGeometry x="12" y="110" width="256" height="50" as="geometry"/></mxCell><mxCell id="rom" value="Boot ROM&lt;br&gt;DIP S1 (8 連): eMMC / Serial Download (USB SDP)&lt;br&gt;SPL は eMMC user +33 KB から (sit.bin @32 KB)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="670" y="50" width="170" height="72" as="geometry"/></mxCell><mxCell id="c13" value="APBH-DMA @0x3300_0000&lt;br&gt;GPMI NAND (disabled)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="670" y="130" width="170" height="40" as="geometry"/></mxCell><mxCell id="c14" value="HAB (セキュアブート): 未署名&lt;br&gt;CAAM は AIPS3 側 (下)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="670" y="178" width="170" height="42" as="geometry"/></mxCell><mxCell id="ocram" value="OCRAM @0x0090_0000&lt;br&gt;SPL 実行 · BL31 @0x0092_0000 常駐&lt;br&gt;(容量は 8MM RM 未入手で未確認、256 KB の見込み)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="soc"><mxGeometry x="860" y="50" width="170" height="62" as="geometry"/></mxCell><mxCell id="c15" value="OCRAM_S @0x0018_0000 (セキュア)&lt;br&gt;容量未確認 (36 KB の見込み)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="soc"><mxGeometry x="860" y="120" width="170" height="44" as="geometry"/></mxCell><mxCell id="rdc" value="RDC @0x303D_0000 (DT 外、RM)&lt;br&gt;M4 = domain1: UART4 (ATF 既定) + ECSPI2/GPIO3/GPIO5 (自前 ATF パッチ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="860" y="172" width="170" height="48" as="geometry"/></mxCell><mxCell id="ddrc" value="DDRC @0x3D40_0000 (fsl,imx8mm-ddrc)&lt;br&gt;+ DDR PHY · DDR PMU @0x3D80_0000&lt;br&gt;&lt;br&gt;LPDDR4 32-bit&lt;br&gt;3000 MT/s (training 3000/400/100)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="soc"><mxGeometry x="1050" y="50" width="150" height="170" as="geometry"/></mxCell><mxCell id="noc" value="AXI / AHB スイッチファブリック (NIC-301 / NoC。mainline DT にノード無し、busfreq 不使用)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bbbbbb;strokeColor=#555555;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="soc"><mxGeometry x="640" y="250" width="40" height="870" as="geometry"/></mxCell><mxCell id="hsio" value="HSIOMIX [0] — USB OTG ×2 (ChipIdea、USB 2.0) · PCIe [1]。8MM に hsio blk-ctrl は無い" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#fafafa;strokeColor=#777777;" vertex="1" parent="soc"><mxGeometry x="20" y="250" width="600" height="140" as="geometry"/></mxCell><mxCell id="otg1" value="usbotg1 @0x32E4_0000 + usbphynop1 [2]&lt;br&gt;dr_mode=host (ptn5110 無し)&lt;br&gt;→ 外部 USB 2.0 ×4 (ハブ経由、型番未確認)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="hsio"><mxGeometry x="10" y="32" width="180" height="48" as="geometry"/></mxCell><mxCell id="otg2" value="usbotg2 @0x32E5_0000 + usbphynop2 [3]&lt;br&gt;disabled: 配下は GL850 ハブ + 88W8897&lt;br&gt;WiFi/BT メザニン (port4) のみ、外部ポート無し" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="hsio"><mxGeometry x="10" y="86" width="180" height="48" as="geometry"/></mxCell><mxCell id="pcie" value="PCIe @0x3380_0000 + PHY @0x32F0_0000 [1]&lt;br&gt;disabled (XPI に引き出されていない)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="hsio"><mxGeometry x="200" y="32" width="180" height="48" as="geometry"/></mxCell><mxCell id="c16" value="reg_pcie0 (GPIO1_IO05) も disabled&lt;br&gt;= LT9611 の IRQ 線を Low に叩くため" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="hsio"><mxGeometry x="200" y="86" width="180" height="48" as="geometry"/></mxCell><mxCell id="c17" value="GPC: hsiomix [0] · pcie [1] (子) · otg1 [2] · otg2 [3]&lt;br&gt;いずれも on (DT 既定)。8MP と違い USB は ChipIdea (USB 2.0 のみ) で、hsio/hdmi の blk-ctrl は存在しない" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="hsio"><mxGeometry x="390" y="32" width="200" height="102" as="geometry"/></mxCell><mxCell id="dispmix" value="DISPMIX [10] — disp_blk_ctrl @0x32E2_8000 (CSI_BRIDGE / LCDIF / MIPI_DSI / MIPI_CSI)、MIPI PHY [11]" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#fafafa;strokeColor=#777777;" vertex="1" parent="soc"><mxGeometry x="20" y="405" width="600" height="150" as="geometry"/></mxCell><mxCell id="lcdif" value="eLCDIF @0x32E0_0000 (lcdif)&lt;br&gt;CRTC = /dev/dri/card0&lt;br&gt;SPL スプラッシュの FB 走査" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="dispmix"><mxGeometry x="10" y="32" width="180" height="52" as="geometry"/></mxCell><mxCell id="dsim" value="Samsung DSIM @0x32E1_0000 (mipi_dsi)&lt;br&gt;MIPI DSI 4 レーン 648 Mbps/lane&lt;br&gt;→ LT9611 (基板上) → HDMI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="dispmix"><mxGeometry x="200" y="32" width="180" height="52" as="geometry"/></mxCell><mxCell id="csi" value="CSI bridge @0x32E2_0000 · MIPI CSI @0x32E3_0000&lt;br&gt;disabled (J59 カメラ未使用)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="dispmix"><mxGeometry x="390" y="32" width="200" height="52" as="geometry"/></mxCell><mxCell id="c18" value="SPL スプラッシュは eLCDIF → DSIM → LT9611 (I2C) をレジスタ直叩き (パッチ 0002/0010)、0005 で LCDIF/DSI ドメインを養子縁組。LT9611 の PCR 位相抽選 (pitfalls #23) が最大の罠。HDMI は SoC 内蔵ではなくブリッジ経由" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="dispmix"><mxGeometry x="10" y="92" width="580" height="46" as="geometry"/></mxCell><mxCell id="c19" value="GPUMIX [4] / GPU [5]&lt;br&gt;GC NanoUltra 3D @0x3800_0000 · GC320 2D @0x3800_8000 (vivante,gc)&lt;br&gt;on: weston が etnaviv で使用 (PMIC buck3 VDD_GPU を always-on にしないと 30 s 後に落ちる)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="20" y="570" width="290" height="100" as="geometry"/></mxCell><mxCell id="c20" value="VPUMIX [6] — vpu_blk_ctrl @0x3833_0000&lt;br&gt;G1 [7] @0x3830_0000 (H.264/VP8 dec) · G2 [8] @0x3831_0000 (HEVC/VP9 dec) · H1 [9] enc (DT ノード無し)&lt;br&gt;on、製品では未使用。PMIC buck4 VDD_VPU も always-on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="soc"><mxGeometry x="330" y="570" width="290" height="100" as="geometry"/></mxCell><mxCell id="audio" value="オーディオ (8MM に AUDIOMIX ドメインは無い、AIPS1 の SPBA1 @0x3000_0000 配下)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#f0f0f0;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="soc"><mxGeometry x="20" y="685" width="600" height="110" as="geometry"/></mxCell><mxCell id="c21" value="SAI2 @0x3002_0000 · SAI3 @0x3003_0000 on&lt;br&gt;→ WM8524 コーデック → 3.5 mm ジャック (EVK 遺産、未使用)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="audio"><mxGeometry x="10" y="32" width="250" height="40" as="geometry"/></mxCell><mxCell id="c22" value="SPDIF @0x3009_0000 on&lt;br&gt;(未使用)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="audio"><mxGeometry x="270" y="32" width="140" height="40" as="geometry"/></mxCell><mxCell id="c23" value="SAI1/5/6 · MICFIL (PDM) disabled&lt;br&gt;(MICFIL は CAN INT とパッド競合)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="audio"><mxGeometry x="420" y="32" width="170" height="40" as="geometry"/></mxCell><mxCell id="c24" value="SDMA2 @0x302C_0000 · SDMA3 @0x302B_0000 (音声用 DMA、AIPS1) on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="audio"><mxGeometry x="10" y="76" width="580" height="26" as="geometry"/></mxCell><mxCell id="c25" value="8MM に無いもの (8MP との差): NPU · ISP · HDMI TX · FlexCAN · EQOS · HiFi4 DSP · LVDS/LDB · HDMIMIX/MEDIAMIX の blk-ctrl。CAN は SPI の MCP2515 で外付け、HDMI は DSI→LT9611 ブリッジ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="soc"><mxGeometry x="20" y="810" width="600" height="56" as="geometry"/></mxCell><mxCell id="aips1" value="AIPS1 @0x3000_0000 — システム制御・GPIO・SPBA1 (fsl,aips-bus)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#fafafa;strokeColor=#777777;" vertex="1" parent="soc"><mxGeometry x="700" y="250" width="500" height="130" as="geometry"/></mxCell><mxCell id="gpio" value="GPIO1/2/4/5 on&lt;br&gt;GPIO3 @0x3022_0000 disabled&lt;br&gt;= M4 の縄張り (CAN INT / ADC CS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="10" y="30" width="115" height="42" as="geometry"/></mxCell><mxCell id="c26" value="IOMUXC (pinctrl) @0x3033_0000&lt;br&gt;IOMUXC_GPR @0x3034_0000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="132" y="30" width="115" height="42" as="geometry"/></mxCell><mxCell id="ccm" value="CCM @0x3038_0000 · ANATOP @0x3036_0000&lt;br&gt;CCGR は domain 権限付き (10-cortex-m4 §)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="254" y="30" width="115" height="42" as="geometry"/></mxCell><mxCell id="src" value="SRC @0x3039_0000 (M4RCR)&lt;br&gt;GPC @0x303A_0000 ([0..11])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="376" y="30" width="115" height="42" as="geometry"/></mxCell><mxCell id="c27" value="TMU @0x3026_0000&lt;br&gt;SDMA2/3 @0x302C/302B_0000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="10" y="80" width="115" height="42" as="geometry"/></mxCell><mxCell id="c28" value="WDOG1 @0x3028_0000&lt;br&gt;on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="132" y="80" width="115" height="42" as="geometry"/></mxCell><mxCell id="c29" value="WDOG2 · WDOG3&lt;br&gt;disabled ×2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="254" y="80" width="115" height="42" as="geometry"/></mxCell><mxCell id="c30" value="OCOTP (fuse) @0x3035_0000&lt;br&gt;SNVS (RTC / pwrkey) @0x3037_0000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="aips1"><mxGeometry x="376" y="80" width="115" height="42" as="geometry"/></mxCell><mxCell id="aips2" value="AIPS2 @0x3040_0000" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#fafafa;strokeColor=#777777;" vertex="1" parent="soc"><mxGeometry x="700" y="385" width="500" height="70" as="geometry"/></mxCell><mxCell id="c31" value="PWM1〜4 @0x3066_0000〜 disabled ×4&lt;br&gt;(PWM1 は EVK のバックライト用)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips2"><mxGeometry x="10" y="32" width="230" height="30" as="geometry"/></mxCell><mxCell id="c32" value="System Counter @0x306A_0000 on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips2"><mxGeometry x="250" y="32" width="240" height="30" as="geometry"/></mxCell><mxCell id="aips3" value="AIPS3 @0x3080_0000" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=11;fontStyle=1;fillColor=#fafafa;strokeColor=#777777;" vertex="1" parent="soc"><mxGeometry x="700" y="480" width="500" height="400" as="geometry"/></mxCell><mxCell id="mu" value="MU @0x30AA_0000&lt;br&gt;A53 ⇄ M4&lt;br&gt;rpmsg kick" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="10" y="32" width="90" height="62" as="geometry"/></mxCell><mxCell id="ecspi2" value="ECSPI2 @0x3083_0000&lt;br&gt;M4 所有: MCP2515 + ADS8688&lt;br&gt;(Linux disabled)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="108" y="32" width="90" height="62" as="geometry"/></mxCell><mxCell id="uart3" value="UART3 @0x3088_0000&lt;br&gt;on: GPS (ttymxc2)&lt;br&gt;J62 pin16/18" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="206" y="32" width="90" height="62" as="geometry"/></mxCell><mxCell id="i2c4" value="I2C4 @0x30A5_0000&lt;br&gt;on: LT9611 @0x3b&lt;br&gt;(400 kHz)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="304" y="32" width="90" height="62" as="geometry"/></mxCell><mxCell id="usdhc3" value="uSDHC3 @0x30B6_0000&lt;br&gt;eMMC 8-bit HS400&lt;br&gt;mmcblk2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="402" y="32" width="90" height="62" as="geometry"/></mxCell><mxCell id="sdma1" value="SDMA1 @0x30BD_0000&lt;br&gt;UART/SPI の DMA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="10" y="112" width="90" height="62" as="geometry"/></mxCell><mxCell id="ecspi1" value="ECSPI1 @0x3082_0000&lt;br&gt;disabled (パッドは&lt;br&gt;UART3 4 線と共用)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="108" y="112" width="90" height="62" as="geometry"/></mxCell><mxCell id="uart1" value="UART1 @0x3086_0000&lt;br&gt;on (ttymxc0)、J62 pin8/10 は&lt;br&gt;不通 (未配線疑い)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="206" y="112" width="90" height="62" as="geometry"/></mxCell><mxCell id="i2c1" value="I2C1 @0x30A2_0000&lt;br&gt;on: PMIC BD71837" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="304" y="112" width="90" height="62" as="geometry"/></mxCell><mxCell id="usdhc2" value="uSDHC2 @0x30B5_0000&lt;br&gt;microSD (on)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="402" y="112" width="90" height="62" as="geometry"/></mxCell><mxCell id="caam3" value="CAAM crypto @0x3090_0000&lt;br&gt;on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="10" y="192" width="90" height="62" as="geometry"/></mxCell><mxCell id="ecspi3" value="ECSPI3 @0x3084_0000&lt;br&gt;disabled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="108" y="192" width="90" height="62" as="geometry"/></mxCell><mxCell id="uart4" value="UART4 @0x30A6_0000&lt;br&gt;M4 所有 (Linux disabled)&lt;br&gt;M4 コンソール = J64" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="206" y="192" width="90" height="62" as="geometry"/></mxCell><mxCell id="i2c2" value="I2C2 @0x30A3_0000&lt;br&gt;on、未使用&lt;br&gt;(AM1805 RTC は未実装)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="304" y="192" width="90" height="62" as="geometry"/></mxCell><mxCell id="fec" value="FEC @0x30BE_0000 (RGMII)&lt;br&gt;eth0、PHY AR8031/8033&lt;br&gt;reset GPIO4_IO1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="402" y="192" width="90" height="62" as="geometry"/></mxCell><mxCell id="spba" value="SPBA2 共有バス&lt;br&gt;(ECSPI / UART)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="aips3"><mxGeometry x="10" y="272" width="90" height="62" as="geometry"/></mxCell><mxCell id="flexspi" value="FlexSPI @0x30BB_0000&lt;br&gt;on (EVK 遺産、XPI に&lt;br&gt;フラッシュ無し)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="108" y="272" width="90" height="62" as="geometry"/></mxCell><mxCell id="uart2" value="UART2 @0x3089_0000&lt;br&gt;Linux console ttymxc1&lt;br&gt;= J63" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="206" y="272" width="90" height="62" as="geometry"/></mxCell><mxCell id="i2c3" value="I2C3 @0x30A4_0000&lt;br&gt;disabled (EVK の&lt;br&gt;エキスパンダ/カメラ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="304" y="272" width="90" height="62" as="geometry"/></mxCell><mxCell id="usdhc1" value="uSDHC1 @0x30B4_0000&lt;br&gt;disabled&lt;br&gt;(SDIO WiFi 無し)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=9;" vertex="1" parent="aips3"><mxGeometry x="402" y="272" width="90" height="62" as="geometry"/></mxCell><mxCell id="c33" value="低速ペリフェラル (SPBA2 を含む)。8MM には FlexCAN / EQOS が無い。ECSPI2 と UART4 は RDC で M4 ドメイン、GPIO3 は Linux 側 disabled (gpio-mxc が IMR をクリアして M4 の CAN INT を消す、pitfalls #31)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="aips3"><mxGeometry x="10" y="356" width="480" height="34" as="geometry"/></mxCell><mxCell id="c34" value="AIPS4 @0x32C0_0000 = DISPMIX / HSIOMIX の制御レジスタ側 (eLCDIF、DSIM、CSI、disp_blk_ctrl、usbotg1/2、PCIe PHY)。物理配置は左列として描いている" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=2;" vertex="1" parent="soc"><mxGeometry x="700" y="895" width="500" height="56" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;色&lt;/b&gt;: 青 = Linux が使用 / 橙 = M4 (Zephyr) 所有 / 紫 = システム制御 / 黄 = メモリ / 灰点線 = DT で disabled・非搭載。「×n」「A · B」= 同状態の複数インスタンスを 1 箱に省略&lt;br&gt;&lt;b&gt;起動&lt;/b&gt;: Boot ROM → SPL (OCRAM、DDR training、eLCDIF/DSIM/LT9611 直叩きスプラッシュ、m4-fw.img を DDR 0x4600_0000 へ) → シム @0x4020_0000 → BL31 @0x0092_0000 (M4 fw を TCML へコピーして SRC で起動 = M4 先住) → falcon-a/b.itb (Image @0x4040_0000 / DTB @0x4310_0000) → Linux は remoteproc attach、MU 経由 rpmsg で can0 (MCP2515)&lt;br&gt;&lt;b&gt;フォールバック&lt;/b&gt;: boot_os=no → U-Boot proper → extlinux。実機は prod (slot B) 稼働、S1 = eMMC 固定&lt;br&gt;&lt;b&gt;根拠&lt;/b&gt;: imx8mm-xpi.dts (mainline 6.12 dtsi でコンパイル) の /soc 配下ノードと GPC ドメイン、docs/imx8mm-xpi-bringup 01/08/09/10/11、XPI 仕様書 V1.1、Zephyr can-gw 8MM overlay" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fillColor=#fffde7;strokeColor=#d6b656;spacingLeft=6;spacingTop=4;" vertex="1" parent="soc"><mxGeometry x="700" y="965" width="500" height="150" as="geometry"/></mxCell><mxCell id="ddr" value="&lt;b&gt;LPDDR4 2 GB&lt;/b&gt; — 0x4000_0000〜0xBFFF_FFFF (仕様表の標準 1 GB ではなく上位構成)&lt;br&gt;&lt;br&gt;0x4020_0000  BL33 シム (ATF が bl31_params を無視して跳ぶ先)&lt;br&gt;0x4040_0000  kernel Image (falcon.itb ≈21.5 MB から)&lt;br&gt;0x4310_0000  DTB&lt;br&gt;0x4600_0000  M4 fw ステージング (SPL が m4-fw.img を置き、BL31 が TCML へコピー)&lt;br&gt;0xB800_0000  vdev0vring0 / 0xB800_8000 vdev0vring1 (32 KB ずつ、no-map)&lt;br&gt;0xB80F_F000  rsc_table 4 KB (M4 が attach 用に publish、warm reboot で残存する罠)&lt;br&gt;0xB840_0000  vdevbuffer 1 MB (shared-dma-pool)&lt;br&gt;0xBFA0_0000〜 上端 6 MB = SPL スプラッシュ FB (カーネルは mem=2042M)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1610" y="40" width="400" height="310" as="geometry"/></mxCell><mxCell id="j62" value="J62 40pin ヘッダ (RPi 互換配列)&lt;br&gt;ECSPI2: pin19/21/23 (SCLK/MOSI/MISO) + CS pin24 = GPIO5_IO13 · ADS8688 CS pin15 = GPIO3_IO21 · CAN INT pin22 = GPIO3_IO24 · GPS: pin16/18 = UART3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1610" y="370" width="400" height="60" as="geometry"/></mxCell><mxCell id="mcp" value="MCP2515 CAN HAT&lt;br&gt;(SPI CS0、INT GPIO3_IO24)&lt;br&gt;→ CAN バス 1 Mbps" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1610" y="440" width="125" height="56" as="geometry"/></mxCell><mxCell id="ads" value="ADS8688 モジュール&lt;br&gt;8ch 16-bit ADC&lt;br&gt;(SPI CS1、raw SPI)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1747" y="440" width="125" height="56" as="geometry"/></mxCell><mxCell id="gps" value="GPS u-blox ZOE-M8Q&lt;br&gt;UART3 9600 8N1&lt;br&gt;(ttymxc2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1885" y="440" width="125" height="56" as="geometry"/></mxCell><mxCell id="emmc" value="&lt;b&gt;eMMC Samsung 8 GB (uSDHC3、HS400 ES)&lt;/b&gt; — user 領域、msdos。boot0/boot1 は未使用 (ベンダは boot0 起動だった)&lt;br&gt;&lt;br&gt;+32 KB  sit.bin (Secondary Image Table) · +33 KB imx-boot A (SPL + DDR fw + BL31 + u-boot.itb) ← ROM&lt;br&gt;+2081 KB imx-boot B (予備)&lt;br&gt;+4 MB   U-Boot env 8 KB (デッドマン boot_os、OTA の upgrade_available)&lt;br&gt;p1 BOOTA 256 MB FAT: falcon-a.itb / u-boot.itb / m4-fw.img / extlinux&lt;br&gt;p2 BOOTB 256 MB FAT · p3 RSV 4 MB&lt;br&gt;p5 roota 1536 MB ext4 · p6 rootb (製品は slot B 稼働)&lt;br&gt;p7 data 128 MB ext4 (/data)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1610" y="516" width="400" height="230" as="geometry"/></mxCell><mxCell id="pmic" value="PMIC ROHM BD71837 (I2C1)&lt;br&gt;8 buck、buck3/4 (GPU/VPU) は always-on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1610" y="766" width="190" height="56" as="geometry"/></mxCell><mxCell id="sd" value="microSD スロット&lt;br&gt;(uSDHC2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1820" y="766" width="190" height="56" as="geometry"/></mxCell><mxCell id="rj45" value="Ethernet PHY AR8031/8033 (RGMII)&lt;br&gt;→ RJ45 = eth0 (1 Gbps)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1610" y="832" width="190" height="56" as="geometry"/></mxCell><mxCell id="dcin" value="DC 5 V / 3 A (USB-C J8)&lt;br&gt;GPIO 5 V ピン給電でも起動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1820" y="832" width="190" height="56" as="geometry"/></mxCell><mxCell id="j63" value="J63 (4P) = デバッグ UART2&lt;br&gt;ttymxc1 115200 (FTDI)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=9;" vertex="1" parent="1"><mxGeometry x=