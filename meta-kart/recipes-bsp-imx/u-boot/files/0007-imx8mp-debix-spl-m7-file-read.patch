From: build <build@localhost>
Subject: [PATCH] imx8mp: SPL — Cortex-M7 ファーム (m7-fw.img) をファイルとして読み DDR にステージング

boot パーティションの m7-fw.img (M7FW ヘッダ + zephyr.bin) を検証して
0x46000000 に置く。ITCM 配置と起動は BL31 (imx-atf 0001-imx8mp-bl31-start-m7)。
ファイルが無ければ無言で M7 なし構成。8MM の 0011 の 8MP 移植で、
kas/imx8mp-m7.yml が注入する。

Upstream-Status: Inappropriate [product-specific falcon integration]
---
--- a/board/freescale/imx8mp_evk/Makefile
+++ b/board/freescale/imx8mp_evk/Makefile
@@ -5,6 +5,7 @@
 #
 
 obj-y += imx8mp_evk.o
+obj-$(CONFIG_SPL_BUILD) += spl_m7.o
 
 ifdef CONFIG_SPL_BUILD
 obj-y += spl.o
--- /dev/null
+++ b/board/freescale/imx8mp_evk/spl_m7.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * spl_m7.c — Cortex-M7 ファーム (m7-fw.img) を boot パーティションのファイルとして
+ * 読み、検証して DDR ステージングへ置く。ITCM への配置と起動 (CPUWAIT 解除) は
+ * BL31 が行う (imx-atf 0001-imx8mp-bl31-start-m7)。SPL は TCM 内で実行されるため
+ * 直接置けない (8MM と同じ理由)。8MM の 0011-imx8mm-spl-m4-file-read の 8MP 移植。
+ *
+ * ファイル形式 (16B ヘッダ + payload、falcon-itb.bb が生成):
+ *   0x00 magic "M7FW" / 0x04 payload 長 (LE32) / 0x08 payload の CRC32 (LE32)
+ *   0x0C version (LE32, 表示用) / 0x10 payload = zephyr.bin (先頭がベクタ)
+ *
+ * ファイル無し = M7 なし構成 (正常、無言)。壊れていれば警告して M7 スキップ
+ * (ステージングは無効のままなので BL31 のゲートが弾く)。
+ */
+#include <common.h>
+#include <asm/io.h>
+#include <cpu_func.h>
+#include <fat.h>
+#include <mmc.h>
+#include <part.h>
+#include <spl.h>
+#include <u-boot/crc.h>
+
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_SPL_OS_BOOT) && defined(CONFIG_SPL_FS_FAT)
+
+#define M7_IMG_NAME	"m7-fw.img"
+#define M7_STAGING	0x46000000UL	/* BL31 パッチ M7_STAGING と一致必須 */
+#define M7_SCRATCH	0x45f00000UL	/* img (ヘッダ付き) の一時読み込み先 */
+#define M7_MAGIC	0x5746374dUL	/* "M7FW" (LE) */
+#define M7_MAX_PAYLOAD	0x20000UL	/* ITCM 128KB */
+
+void spl_board_prepare_for_boot(void)
+{
+	struct disk_partition info;
+	struct blk_desc *desc;
+	struct mmc *mmc;
+	u32 size, crc;
+	int part = 0, i;
+	long len;
+
+	/* stale ステージングの無効化 (DDR は warm reboot で消えない) */
+	writel(0, M7_STAGING);
+	writel(0, M7_STAGING + 4);
+	flush_dcache_range(M7_STAGING, M7_STAGING + 64);
+
+	mmc = find_mmc_device(1);	/* SPL の DM では eMMC (usdhc3) = dev 1 (mmc_env.c 参照) */
+	if (!mmc)
+		return;
+	desc = mmc_get_blk_desc(mmc);
+	if (!desc)
+		return;
+	/* falcon と同じ「MBR bootable フラグの立ったパーティション」を使う */
+	for (i = 1; i <= 4; i++) {
+		if (part_get_info(desc, i, &info))
+			continue;
+		if (info.bootable) {
+			part = i;
+			break;
+		}
+	}
+	if (!part || fat_register_device(desc, part))
+		return;
+
+	len = file_fat_read(M7_IMG_NAME, (void *)M7_SCRATCH,
+			    0x10 + M7_MAX_PAYLOAD);
+	if (len < 0x10)
+		return;		/* 無ファイル = M7 なし (正常) */
+
+	size = readl(M7_SCRATCH + 4);
+	crc = readl(M7_SCRATCH + 8);
+	if (readl(M7_SCRATCH) != M7_MAGIC ||
+	    size > M7_MAX_PAYLOAD || (long)(0x10 + size) > len ||
+	    crc32(0, (void *)(M7_SCRATCH + 0x10), size) != crc) {
+		printf("spl: %s invalid (len=%ld) — M7 skipped\n",
+		       M7_IMG_NAME, len);
+		return;
+	}
+	memcpy((void *)M7_STAGING, (void *)(M7_SCRATCH + 0x10), size);
+	flush_dcache_range(M7_STAGING, M7_STAGING + size);
+	printf("spl: %s staged (%u bytes, ver %u)\n",
+	       M7_IMG_NAME, size, readl(M7_SCRATCH + 12));
+}
+#endif /* CONFIG_SPL_BUILD && CONFIG_SPL_OS_BOOT && CONFIG_SPL_FS_FAT */
