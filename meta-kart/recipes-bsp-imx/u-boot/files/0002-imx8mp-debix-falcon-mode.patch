+
+#ifdef CONFIG_SPL_OS_BOOT
+/*
+ * Falcon mode (DEBIX/8MP): SPL が FAT 上の falcon.itb (ATF + Image + DTB)
+ * をロードし、U-Boot proper を飛ばしてカーネル直行する。
+ * 設計は docs/imx8mm-xpi-bringup/08-falcon.md (8MM と同一)。A/B は
+ * docs/imx8mp-debix-bringup/04-falcon.md「A/B とスロット選択」:
+ *  - BOOT 領域は env の ab_slot で選ぶ (a → p1、b → p2)。env が読めない
+ *    ときだけ MBR の bootable フラグに従う (ab コマンドは両方を揃える)
+ *  - OTA 試行中 (upgrade_available=1) も通常と同じ falcon 経路で新しい面を
+ *    起動する。試行回数 (bootcount) は SPL が数え、bootlimit を超えたら
+ *    ab_fallback_slot へ戻す。U-Boot proper の bootcount は proper 経路
+ *    (デッドマン後など) でだけ重ねて数えるが、どちらも戻す方向にしか効かない
+ *  - 起動した面・経路・試行中かを /chosen (ab,*) でカーネルに伝える
+ *  - ATF (lf-6.6.52) は bl31_params を無視して 0x40200000 へ跳ぶため、そこに
+ *    x0=DTB でカーネルへ分岐する 8 命令のシムを置く (ATF 無改造)
+ */
+#include <env.h>
+#include <image.h>
+#include <cpu_func.h>
+#include <linux/libfdt.h>
+
+#define FALCON_SHIM_ADDR	0x40200000UL	/* ATF PLAT_NS_IMAGE_OFFSET */
+#define FALCON_KERNEL_ADDR	0x40400000UL	/* falcon.its の load/entry と一致必須 */
+
+/*
+ * FIT メタデータの置き場を固定する。weak 実装は malloc → 失敗時
+ * spl_get_load_buffer(0) = CONFIG_SYS_LOAD_ADDR (0x40400000) に落ちるが、
+ * そこは falcon カーネルのロード先と同一で、loadables コピー中に FIT
+ * メタデータ (ctx->fit) 自身が上書きされて以後のノード参照が壊れる
+ * (実測: DTB 未ロード・シム未設置のまま BL31→0x40200000 に跳んで
+ * 即リセットの 2 秒ループ)。カーネル末尾 (~0x426E0000)・args/fdt
+ * (0x43000000/0x43100000) のどれとも重ならない DRAM に固定する。
+ */
+void *board_spl_fit_buffer_addr(ulong fit_size, int sectors, int bl_len)
+{
+	return (void *)0x48000000UL;
+}
+
+/* ---- A/B: env の ab_slot で BOOT 領域を選び、試行回数を数える ---- */
+static int ab_env_state;	/* 0 = 未読込, 1 = 読込済, -1 = 読めない */
+static char ab_slot_c;		/* 起動に使う面 'a' / 'b'。0 = MBR に従った */
+static bool ab_try;		/* OTA 試行中の起動 */
+static int ab_part;		/* 決めたパーティション (2 回目以降はそのまま返す) */
+
+/* env を 1 回だけ読む (パーティション選択・falcon 判定・M コアで共用) */
+int spl_ab_env_ready(void)
+{
+	if (!ab_env_state) {
+		if (env_init()) {
+			ab_env_state = -1;
+		} else {
+			env_load();
+			ab_env_state = 1;
+		}
+	}
+	return ab_env_state > 0;
+}
+
+int spl_mmc_fs_boot_partition(struct mmc *mmc)
+{
+	const char *slot, *fb;
+	ulong cnt, lim;
+
+	/* 呼ばれるたびに数えないよう、1 回の起動で決めるのは 1 度だけ */
+	if (ab_part)
+		return ab_part;
+	if (!spl_ab_env_ready()) {
+		/* 判断材料が無い: ab コマンドが env と揃えている MBR に従う */
+		ab_part = spl_mmc_first_bootable_partition(mmc);
+		return ab_part;
+	}
+	slot = env_get("ab_slot");
+	if (env_get_yesno("upgrade_available") == 1) {
+		cnt = env_get_ulong("bootcount", 10, 0) + 1;
+		lim = env_get_ulong("bootlimit", 10, 1);
+		if (cnt > lim) {
+			fb = env_get("ab_fallback_slot");
+			if (!fb || (*fb != 'a' && *fb != 'b'))
+				fb = "a";
+			printf("ab: tries > %lu, back to %s\n", lim, fb);
+			env_set("ab_slot", fb);
+			env_set("upgrade_available", "0");
+			env_set("bootcount", "0");
+			slot = fb;
+		} else {
+			/* env_set_ulong は SPL (tiny printf) に無い simple_itoa を使う。
+			 * bootlimit は 1 桁なので 2 桁まであれば足りる */
+			char buf[3] = { '0' + (cnt > 9 ? 9 : cnt), 0, 0 };
+
+			env_set("bootcount", buf);
+			ab_try = true;
+		}
+		if (env_save())
+			puts("ab: save err\n");
+	}
+	ab_slot_c = (slot && *slot == 'b') ? 'b' : 'a';
+	printf("ab: slot %c%s\n", ab_slot_c, ab_try ? " (try)" : "");
+	ab_part = ab_slot_c == 'b' ? 2 : 1;
+	return ab_part;
+}
+
+int spl_start_uboot(void)
+{
+	if (!spl_ab_env_ready()) {
+		/* env 不能 = 判断材料なし。安全側 (proper) へ */
+		puts("Falcon: no env -> proper\n");
+		return 1;
+	}
+	printf("Falcon: ua=%d bos=%d\n",
+	       env_get_yesno("upgrade_available"), env_get_yesno("boot_os"));
+
+	/*
+	 * デッドマンスイッチ: falcon は boot_os=yes の時だけ。発動したら
+	 * ジャンプ前に boot_os=no を書き戻す (SPL_SAVEENV) ので、falcon 経路が
+	 * クラッシュしても次回は必ず proper に落ちて遠隔復旧できる。
+	 * 起動成功時に Linux 側が fw_setenv boot_os yes で再アームする。
+	 * OTA 試行中も同じ (試す経路 = 確定後に走る経路)。
+	 */
+	if (env_get_yesno("boot_os") != 1)
+		return 1;
+
+	env_set("boot_os", "no");
+	if (env_save())
+		puts("Falcon: WARN deadman env_save failed\n");
+
+	return 0;	/* falcon */
+}
+
+/* M コア (Cortex-M7) のファームを置く。M コア構成 (spl_m7.c) が上書きする */
+__weak void spl_mcore_stage(void)
+{
+}
+
+__weak void spl_mcore_fixup_fdt(void *fdt, int chosen)
+{
+}
+
+/* 起動した面・経路・試行中かを /chosen に書く (ab コマンドが読む)。falcon の DTB には
+ * bootargs のための /chosen が必ずある */
+static void ab_fixup_fdt(void *fdt)
+{
+	int off;
+
+	if (fdt_open_into(fdt, fdt, fdt_totalsize(fdt) + 512))
+		return;
+	off = fdt_path_offset(fdt, "/chosen");
+	if (off < 0)
+		return;
+	if (ab_slot_c)
+		fdt_setprop_string(fdt, off, "ab,slot", ab_slot_c == 'b' ? "b" : "a");
+	fdt_setprop_string(fdt, off, "ab,boot-path", "falcon");
+	if (ab_try)
+		fdt_setprop_empty(fdt, off, "ab,try");
+	spl_mcore_fixup_fdt(fdt, off);
+	flush_dcache_range((ulong)fdt, (ulong)fdt + fdt_totalsize(fdt) + 64);
+}
+
+static void emit_bl33_shim(ulong shim, ulong fdt, ulong kernel)
+{
+	u32 *p = (u32 *)shim;
+
+	/* movz/movk (アドレスは 32bit に収まる) + br。x1-x3 はカーネル規約で 0 */
+	*p++ = 0xd2800000 | (u32)((fdt & 0xffff) << 5);		/* movz x0, #lo16 */
+	*p++ = 0xf2a00000 | (u32)(((fdt >> 16) & 0xffff) << 5);	/* movk x0, #hi16, lsl #16 */
+	*p++ = 0xd2800010 | (u32)((kernel & 0xffff) << 5);	/* movz x16, #lo16 */
+	*p++ = 0xf2a00010 | (u32)(((kernel >> 16) & 0xffff) << 5); /* movk x16, #hi16, lsl #16 */
+	*p++ = 0xd2800001;					/* movz x1, #0 */
+	*p++ = 0xd2800002;					/* movz x2, #0 */
+	*p++ = 0xd2800003;					/* movz x3, #0 */
+	*p++ = 0xd61f0200;					/* br x16 */
+
+	flush_dcache_range(shim, shim + 64);
+}
+
+void spl_perform_fixups(struct spl_image_info *spl_image)
+{
+	void *fdt = spl_image->fdt_addr;
+
+	/*
+	 * u-boot proper (u-boot.itb、os="u-boot") は素通しする。falcon.itb の
+	 * atf ノードは os 無し (8MM 実測で os=255)。
+	 */
+	if (spl_image->os == IH_OS_U_BOOT || !fdt)
+		return;
+
+	/* /memory を実 DRAM 構成で更新 (bootargs は DTB に焼き込み済み) */
+	spl_fixup_fdt(fdt);
+	flush_dcache_range((ulong)fdt,
+			   (ulong)fdt + fdt_totalsize(fdt) + 64);
+
+	/* M コアを置いてから (FAT を M コアの領域へ切り替える)、起動情報を書く */
+	spl_mcore_stage();
+	ab_fixup_fdt(fdt);
+
+	emit_bl33_shim(FALCON_SHIM_ADDR, (ulong)fdt,
+			    FALCON_KERNEL_ADDR);
+
+	printf("Falcon: shim@%lx fdt@%p kernel@%lx\n",
+	       FALCON_SHIM_ADDR, fdt, FALCON_KERNEL_ADDR);
+}
+#endif /* CONFIG_SPL_OS_BOOT */
