+/* Size to advertise to fullscreen/maximized clients: the output size, or
+ * the configured client-size when set (clamped to the output). */
+static void
+kiosk_shell_get_client_size(struct kiosk_shell *shell,
+			    struct weston_output *output,
+			    int32_t *width, int32_t *height)
+{
+	*width = output->width;
+	*height = output->height;
+	if (shell->forced_client_w > 0 && shell->forced_client_w < *width)
+		*width = shell->forced_client_w;
+	if (shell->forced_client_h > 0 && shell->forced_client_h < *height)
+		*height = shell->forced_client_h;
+}
+
+/* With a forced client size the surface is anchored at the output's
+ * top-left corner; otherwise keep the stock centering behavior. */
+static void
+kiosk_shell_position_view_on_output(struct kiosk_shell *shell,
+				    struct weston_view *view,
+				    struct weston_output *output)
+{
+	if (shell->forced_client_w > 0 || shell->forced_client_h > 0)
+		weston_view_set_position(view, output->pos);
+	else
+		weston_shell_utils_center_on_output(view, output);
+}
