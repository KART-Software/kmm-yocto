[Unit]
Description=Kart Machine Manager Application
After=basic.target data.mount
Requires=data.mount

[Service]
Type=simple
User=kart
Group=kart
WorkingDirectory=/opt/kart/kart-machine-manager/app
EnvironmentFile=-/run/kmm-env
# Secrets/config live on the shared data partition (survives OTA, never baked
# into release images). Provision once: scp .env root@<host>:/data/kmm.env
EnvironmentFile=-/data/kmm.env
Environment=KMM_LOG_DIR=/data/log/kmm/
Environment=WAYLAND_DISPLAY=wayland-1
Environment=QT_QPA_PLATFORM=wayland
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=+/bin/sh -c 'uid=$(id -u kart); echo "XDG_RUNTIME_DIR=/run/user/$uid" > /run/kmm-env'
ExecStartPre=+/bin/sh -c 'uid=$(id -u kart); mkdir -p /run/user/$uid && chown kart:kart /run/user/$uid'
ExecStartPre=+/bin/sh -c 'mkdir -p /data/log/kmm && chown kart:kart /data/log/kmm'
ExecStart=/usr/bin/python3 /opt/kart/kart-machine-manager/app/main.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
