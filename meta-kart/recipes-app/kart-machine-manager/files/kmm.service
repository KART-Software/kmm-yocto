[Unit]
Description=Kart Machine Manager Application
# Direct start: the app shows the GUI immediately, so it must be ordered
# after the compositor and CAN are ready (the old kmm-start notifier did this).
After=weston.service can0-up.service data.mount
Requires=weston.service data.mount
Wants=can0-up.service

[Service]
# The app sends READY=1 on the first window expose -> "active = pixels on screen"
# (resolved-delayed-start.timer keys off this).
Type=notify
User=kart
Group=kart
# Secrets/config live on the shared data partition (survives OTA, never baked
# into release images). Provision once: scp .env root@<host>:/data/kmm.env
EnvironmentFile=-/data/kmm.env
# The wayland socket lives in weston.service's fixed RuntimeDirectory
# (/run/wayland) — no uid anywhere.
Environment=XDG_RUNTIME_DIR=/run/wayland
Environment=WAYLAND_DISPLAY=wayland-1
Environment=QT_QPA_PLATFORM=wayland
ExecStart=/usr/bin/kmm
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
