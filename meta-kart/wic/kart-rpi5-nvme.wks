# Kart product - Raspberry Pi 5 NVMe boot image layout
# Boot partition: FAT32 with RPi firmware + kernel
# Root partition: ext4
# Data partition: ext4 persistent storage (survives rootfs updates, fstab managed by kart-image.bb)

part --source bootimg-partition --ondisk nvme0n1 --fstype=vfat --label boot --active --align 4096 --size 256M --use-uuid
part / --source rootfs --ondisk nvme0n1 --fstype=ext4 --label root --align 4096 --use-uuid
part --ondisk nvme0n1 --fstype=ext4 --label data --align 4096 --fixed-size 128M
