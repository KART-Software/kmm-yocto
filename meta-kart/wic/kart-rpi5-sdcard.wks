# Kart product - Raspberry Pi 5 SD card boot image layout
# Boot partition: FAT32 with RPi firmware + kernel
# Root partition: ext4
# Data partition: ext4 persistent storage (survives rootfs updates)

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 256M
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --align 4096
part /data --ondisk mmcblk0 --fstype=ext4 --label data --align 4096 --fixed-size 128M
