From: kart <kart@localhost>
Subject: [PATCH] drm/bridge: lontium-lt9611: DSI レーン数を DT の data-lanes から設定可能に

XPI の 800x480 パネル (pclk 32MHz) は 4 レーンだと 192Mbps/lane で
LT9611 の MIPI RX ロック下限 (実測 280〜312Mbps の間) を割る。
port@0 endpoint の data-lanes からレーン数を読めるようにし (省略時は
従来通り 4)、2 レーンで 384Mbps/lane に引き上げて受信レンジに入れる。

Upstream-Status: Inappropriate [needs binding discussion for submission]

--- a/drivers/gpu/drm/bridge/lontium-lt9611.c	2026-08-11 14:02:15.039686475 +0900
+++ b/drivers/gpu/drm/bridge/lontium-lt9611.c	2026-08-11 14:02:15.068842149 +0900
@@ -41,6 +41,7 @@
 
 	struct device_node *dsi0_node;
 	struct device_node *dsi1_node;
+	u32 dsi_lanes;
 	struct mipi_dsi_device *dsi0;
 	struct mipi_dsi_device *dsi1;
 	struct platform_device *audio_pdev;
@@ -119,6 +120,10 @@
 		{ 0x8306, 0x0a },
 	};
 
+	/* lane count register: 4 lanes = 0, otherwise the count itself */
+	if (lt9611->dsi_lanes != 4)
+		reg_cfg[0].def = lt9611->dsi_lanes;
+
 	if (lt9611->dsi1_node)
 		reg_cfg[1].def = 0x03;
 
@@ -770,7 +775,7 @@
 		return dsi;
 	}
 
-	dsi->lanes = 4;
+	dsi->lanes = lt9611->dsi_lanes;
 	dsi->format = MIPI_DSI_FMT_RGB888;
 	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
 			  MIPI_DSI_MODE_VIDEO_HSE;
@@ -915,6 +920,25 @@
 
 	lt9611->dsi1_node = of_graph_get_remote_node(dev->of_node, 1, -1);
 
+	/*
+	 * Optional lane count from the port@0 endpoint "data-lanes" property.
+	 * Boards feeding low pixel clocks can use fewer lanes to keep the
+	 * per-lane rate inside the MIPI RX lock range. Default is 4.
+	 */
+	lt9611->dsi_lanes = 4;
+	{
+		struct device_node *ep;
+		int n;
+
+		ep = of_graph_get_endpoint_by_regs(dev->of_node, 0, -1);
+		if (ep) {
+			n = of_property_count_u32_elems(ep, "data-lanes");
+			of_node_put(ep);
+			if (n >= 1 && n <= 4)
+				lt9611->dsi_lanes = n;
+		}
+	}
+
 	lt9611->ac_mode = of_property_read_bool(dev->of_node, "lt,ac-mode");
 
 	return drm_of_find_panel_or_bridge(dev->of_node, 2, -1, NULL, &lt9611->next_bridge);
