/*
 * imx8mp-debix.dts — Polyhex DEBIX Infinity (EMB-IMX8MP-06) 用 kart 製品 DT
 *
 * 根拠は工場イメージ (Ubuntu 20.04 + 5.10 NXP BSP) の実行中 FDT との突き合わせ:
 *  - 実行中 FDT = /boot/imx8mp-evk.dtb (= imx8mp-debix-core-board.dtb と同一物)
 *  - 吸い出し: 工場イメージの /sys/firmware/fdt (実体 /boot/imx8mp-evk.dtb)
 *  - 差分分析: docs/imx8mp-debix-bringup/02-dts-delta.md
 *
 * EVK との差分:
 *  - flexcan1: pinmux を SPDIF_TX/RX → SAI5_RXD1/RXD2 (J2 ヘッダー Pin31/33) に変更。
 *  - flexcan2: 有効化。pin group (SAI5_RXD3/MCLK = J2 Pin35/37) は EVK 定義と工場で一致。
 *  - CAN トランシーバはボードに無い (J2 に出るのは 3.3V TXD/RXD)。工場 DT にも
 *    xceiver-supply が無く、EVK の standby GPIO (gpio5_5/gpio4_27) や I/O エキスパンダ
 *    (pca6416) を DEBIX で触らないよう supply/assert-gpios を削除する。
 *  - micfil (PDM): EVK で flexcan2 と SAI5 パッドを取り合う相手。DEBIX では PDM
 *    マイク未配線なので disabled (EVK の「can2 pin conflict with pdm」コメント参照)。
 *  - pcie/mipi_dsi/dsp: DEBIX/kart では未使用 (PCIe は 19pin FPC のみ、表示は HDMI、
 *    DSP は使わない)。工場 DT も disabled — 未接続プローブのエラーと起動遅延を避ける。
 *  - uart4: EVK 既定の disabled のまま = M7 コンソール予約 (01-m7.md)。
 *  - WiFi (88W8987 / usdhc1): kart 不使用 → EVK 既定の disabled のまま。
 */

#include "imx8mp-evk.dts"

/ {
	model = "Polyhex DEBIX Infinity";
};

&flexcan1 {
	/delete-property/ xceiver-supply;
};

&pinctrl_flexcan1 {
	fsl,pins = <
		MX8MP_IOMUXC_SAI5_RXD1__CAN1_TX		0x154
		MX8MP_IOMUXC_SAI5_RXD2__CAN1_RX		0x154
	>;
};

&flexcan2 {
	/delete-property/ xceiver-supply;
	/delete-property/ pinctrl-assert-gpios;
	status = "okay";
};

&micfil {
	status = "disabled";
};

&pcie {
	status = "disabled";
};

&pcie_phy {
	status = "disabled";
};

&mipi_dsi {
	status = "disabled";
};

&dsp {
	status = "disabled";
};

/* busfreq (DDR 低速バスモード) は使わない:
 *  - キオスク用途で表示は常時稼働 = 低速モードに入れる局面が実質無い
 *  - SPL スプラッシュが LCDIF 走査中のままカーネルへ渡す構成では、ブート
 *    途中の「ddrc freq set to low bus mode」遷移がアクティブな表示 DMA と
 *    衝突してカーネルが恒久ハングする (実測)。無効化で遷移自体を消す */
&{/busfreq} {
	status = "disabled";
};

/* LVDS 経路 (ldb + PHY) は未配線 + slim カーネル (slim-imx8mp.cfg 第二弾) で
 * ドライバも外した。ノードを有効に残すと imx-drm のコンポーネント束ねが
 * ldb を待ち続け、display-subsystem (= /dev/dri の表示カード) ごと現れず
 * weston が「no drm device found」で死ぬ (2026-09-02 実測)。 */
&ldb {
	status = "disabled";
};

&ldb_phy {
	status = "disabled";
};

/* ===== EVK 遺産の死にノード掃除 (2026-09-03、起動時間: udev/probe 削減) =====
 * DEBIX/kart で消費者がいない EVK 有効化ノードを落とす。効果は
 * ① probe 時間 (eqos 0.2s+PHY 等) ② coldplug の uevent 数 ③ dmesg ノイズ
 * (ov5640/pca953x/csis の probe エラー消滅)。根拠: 実配線 (02-dts-delta.md)
 * と実機 dmesg。カーネル config 側は既に SND/V4L2 等を削っており、
 * これはその DT 側の対 (ノードだけ残っていた)。 */

/* 第 2 イーサネット (eqos/eth1): 未配線 (実機で down/リンクなし) */
&eqos {
	status = "disabled";
};

/* オーディオ一式 (無音キオスク。コーデックも未実装) */
&aud2htx {
	status = "disabled";
};

&easrc {
	status = "disabled";
};

&sai2 {
	status = "disabled";
};

&sai3 {
	status = "disabled";
};

&sdma2 {
	status = "disabled";
};

&xcvr {
	status = "disabled";
};

&{/sound-bt-sco} {
	status = "disabled";
};

&{/sound-hdmi} {
	status = "disabled";
};

&{/sound-wm8960} {
	status = "disabled";
};

&{/sound-micfil} {
	status = "disabled";
};

&{/sound-xcvr} {
	status = "disabled";
};

&{/bt_sco_codec} {
	status = "disabled";
};

/* カメラ一式 (未搭載。ov5640 は毎ブート probe エラーを吐いていた) */
&mipi_csi_0 {
	status = "disabled";
};

&mipi_csi_1 {
	status = "disabled";
};

&cameradev {
	status = "disabled";
};

&isi_0 {
	status = "disabled";
};

&isi_1 {
	status = "disabled";
};

&ov5640_0 {
	status = "disabled";
};

/* FlexSPI: NOR 非搭載 (MTD もカーネルから削除済み) */
&flexspi {
	status = "disabled";
};

/* 表示に使わない CRTC (表示は lcdif3=HDMI のみ。lcdif1=DSI/lcdif2=LVDS は
 * 接続先を disabled 済みで、crtc だけ probe されて uevent を増やしていた) */
&lcdif1 {
	status = "disabled";
};

&lcdif2 {
	status = "disabled";
};

/* I/O エキスパンダ (EVK の CSI/LVDS 用 pca6416)。DEBIX に非実装で
 * 毎ブート probe -11 を吐いていた */
&pca6416 {
	status = "disabled";
};

/* LVDS バックライト (EVK 遺産)。DEBIX のパネルは信号連動の自前バックライトで
 * この PWM は未配線。systemd-backlight@ が毎ブート failed になる発生源 */
&lvds_backlight {
	status = "disabled";
};

/* Quad Lite でヒューズアウトされている VPU/NPU の GPC 電源ドメイン。
 * pgc_vpumix (power-domain@8) は「imx-pgc-domain.8: failed to command PGC」
 * を毎ブート 3 連発し (open-issues 旧 #8 の正体)、子の g1/g2/vc8000e
 * (@11/12/13) は永久 deferred でぶら下がっていた */
&pgc_vpumix {
	status = "disabled";
};

&pgc_vpu_g1 {
	status = "disabled";
};

&pgc_vpu_g2 {
	status = "disabled";
};

&pgc_vpu_vc8000e {
	status = "disabled";
};

&pgc_mlmix {
	status = "disabled";
};
