[Unit]
Description=Tailscale node agent
Documentation=https://tailscale.com/kb/
# Start once the network is actually up, so the first connection attempt
# succeeds instead of failing "network unreachable" and backing off ~40s.
# network-online is fast here because wait-online runs with --any (kart-image.bb).
Wants=network-online.target
After=network-online.target kart-data-mount.service
Requires=kart-data-mount.service

[Service]
Environment=TS_LOGS_DIR=/data/tailscale
ExecStartPre=/usr/sbin/tailscaled --cleanup --statedir=/data/tailscale
ExecStart=/usr/sbin/tailscaled --statedir=/data/tailscale --socket=/run/tailscale/tailscaled.sock --port=41641
ExecStopPost=/usr/sbin/tailscaled --cleanup --statedir=/data/tailscale
Restart=on-failure
RuntimeDirectory=tailscale

[Install]
WantedBy=multi-user.target
