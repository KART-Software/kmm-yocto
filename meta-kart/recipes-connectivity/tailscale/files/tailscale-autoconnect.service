[Unit]
Description=Tailscale first-boot auto-connect (injected auth key)
Documentation=https://tailscale.com/kb/
After=tailscaled.service
Wants=tailscaled.service
# Only runs when an auth key has been injected onto the boot partition.
ConditionPathExists=/boot/tailscale.authkey

[Service]
# Type=simple: 'tailscale up' blocks until connected, so run it in the
# background — do NOT delay multi-user.target / boot completion.
Type=simple
ExecStart=/usr/sbin/tailscale-autoconnect.sh

[Install]
WantedBy=multi-user.target
