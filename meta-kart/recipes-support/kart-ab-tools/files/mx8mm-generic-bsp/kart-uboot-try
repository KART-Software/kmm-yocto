#!/bin/sh
# kart-uboot-try <flash.bin> — 新しい U-Boot (imx-boot) を B copy に書き、
# 次回リブートで B から起動するよう PERSIST_SECONDARY_BOOT を立てる。
#
# ROM の挙動 (i.MX8MM):
#   - PSB=1 なら SIT.firstSectorNumber+0x42 = sector 0x1042 の B copy を起動
#   - 電源断 (POR) で PSB はクリアされ、必ず A copy に戻る
#     → 新 U-Boot がハングしても電源を入れ直せば旧 U-Boot で復帰する
# 起動確認後は kart-uboot-commit で A へ昇格させる。
# (busybox 構文のみ)
set -eu

GPR=0x30390098          # SRC_GPR10
PSB_BIT=0x40000000      # bit30 PERSIST_SECONDARY_BOOT
B_SECTOR=4162           # 0x1042
AREA_KIB=2015           # B copy 領域上限 (env 4MiB まで)

[ $# -eq 1 ] || { echo "Usage: kart-uboot-try <flash.bin>" >&2; exit 1; }
NEW="$1"
[ -f "$NEW" ] || { echo "ERROR: $NEW not found" >&2; exit 1; }

size=$(wc -c < "$NEW")
max=$(( AREA_KIB * 1024 ))
if [ "$size" -gt "$max" ]; then
    echo "ERROR: $NEW is ${size}B > B-copy area ${max}B (wks の再設計が必要)" >&2
    exit 1
fi

BASE_DEV=$(sed -n "s/.*root=\(\/dev\/[a-z0-9]*\)p[56].*/\1/p" /proc/cmdline)
[ -n "$BASE_DEV" ] || { echo "ERROR: cannot determine base device" >&2; exit 1; }

echo "Writing $NEW (${size}B) to B copy (${BASE_DEV} sector ${B_SECTOR})..."
dd if="$NEW" of="$BASE_DEV" bs=512 seek="$B_SECTOR" 2>/dev/null
sync

# 読み戻し検証
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
dd if="$BASE_DEV" bs=512 skip="$B_SECTOR" count=$(( (size + 511) / 512 )) 2>/dev/null \
    | head -c "$size" > "$TMP"
if ! cmp -s "$TMP" "$NEW"; then
    echo "ERROR: read-back verification FAILED; B copy not written correctly" >&2
    exit 1
fi

# PSB セット (read-modify-write)
cur=$(devmem "$GPR")
devmem "$GPR" 32 $(( cur | PSB_BIT ))
echo "B copy written (read-back verified) and PERSIST_SECONDARY_BOOT set."
echo "reboot すると新 U-Boot (B copy) で起動する。"
echo "  成功したら: kart-uboot-commit"
echo "  失敗したら: 電源を入れ直す (POR で自動的に A copy へ復帰)"
