#!/bin/sh
# kart-uboot-commit — B copy で起動できた新 U-Boot を A copy (通常起動側) に
# 昇格させ、PERSIST_SECONDARY_BOOT をクリアする。
# 以後は電源断でも新 U-Boot で起動する。冪等。
# (busybox 構文のみ: プロセス置換や conv= は使わない)
set -eu

GPR=0x30390098
PSB_BIT=0x40000000
A_SECTOR=66             # 0x42
B_SECTOR=4162           # 0x1042
AREA_SECTORS=4030       # 2015KiB

BASE_DEV=$(sed -n "s/.*root=\(\/dev\/[a-z0-9]*\)p[56].*/\1/p" /proc/cmdline)
[ -n "$BASE_DEV" ] || { echo "ERROR: cannot determine base device" >&2; exit 1; }

TMP_A=$(mktemp) ; TMP_B=$(mktemp)
trap 'rm -f "$TMP_A" "$TMP_B"' EXIT

dump_a() { dd if="$BASE_DEV" bs=512 skip="$A_SECTOR" count="$AREA_SECTORS" of="$TMP_A" 2>/dev/null; }
dump_b() { dd if="$BASE_DEV" bs=512 skip="$B_SECTOR" count="$AREA_SECTORS" of="$TMP_B" 2>/dev/null; }

cur=$(devmem "$GPR")
if [ $(( cur & PSB_BIT )) -eq 0 ]; then
    # PSB が立っていない = A copy で起動している。A/B が同一なら確定済み。
    dump_a; dump_b
    if cmp -s "$TMP_A" "$TMP_B"; then
        echo "Already committed (A copy active, A == B); nothing to do."
        exit 0
    fi
    echo "WARNING: PERSIST_SECONDARY_BOOT is not set (booted from A copy)." >&2
    echo "         kart-uboot-try で B を起動してから commit すること。" >&2
    exit 1
fi

echo "Promoting B copy -> A copy (${AREA_SECTORS} sectors)..."
dd if="$BASE_DEV" of="$BASE_DEV" bs=512 skip="$B_SECTOR" seek="$A_SECTOR" count="$AREA_SECTORS" 2>/dev/null
sync

# 読み戻し検証 (A 全域と B 全域の一致)
dump_a; dump_b
if ! cmp -s "$TMP_A" "$TMP_B"; then
    echo "ERROR: read-back verification FAILED: A != B after copy." >&2
    echo "       PSB は残したまま。再実行するか、電源入れ直しで旧 A に戻る。" >&2
    exit 1
fi

cur=$(devmem "$GPR")
devmem "$GPR" 32 $(( cur & ~PSB_BIT ))
echo "Committed: new U-Boot promoted to A copy (read-back verified), PSB cleared."
